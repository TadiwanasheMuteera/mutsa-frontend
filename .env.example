# ─── Backend API ─────────────────────────────────────────────────────────────
#
# VITE_API_URL  (recommended — Vercel / Railway / Render / any cloud host)
#   Full URL to your backend API including the /api path segment.
#   Copy this file to .env and fill in your deployed backend URL.
#
VITE_API_URL=https://your-railway-backend.up.railway.app/api

# VITE_API_BASE_URL  (legacy — still supported for local/on-prem setups)
#   Server root URL WITHOUT the /api path.  The app appends /api automatically.
#   Only needed if you are NOT setting VITE_API_URL above.
#
# VITE_API_BASE_URL=http://172.16.14.54:5000
